<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#5522D3FF"
                android:endColor="#0022D3FF"/>
        </shape>
    </item>
    <item
        android:left="30dp" android:top="30dp"
        android:right="30dp" android:bottom="30dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#4422D3FF"/>
            <solid android:color="#0A0F1F"/>
        </shape>
    </item>
</layer-list>