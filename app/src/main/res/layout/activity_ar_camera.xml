<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.isst.SkyOverlayView
        android:id="@+id/skyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/filterBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:background="#AA0F1629"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <CheckBox
            android:id="@+id/cbPlanets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#00D4FF"
            android:checked="true"
            android:text="Planets"
            android:textColor="#E8F4FF"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/cbStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:buttonTint="#00D4FF"
            android:checked="true"
            android:text="Stars"
            android:textColor="#E8F4FF"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/cbSatellites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:buttonTint="#00D4FF"
            android:checked="true"
            android:text="Satellites"
            android:textColor="#E8F4FF"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvARStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp"
        android:background="#AA070B1A"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="8dp"
        android:text="Initializing..."
        android:textColor="#00E5FF"
        android:textSize="11sp" />

    <ImageButton
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="#AA0F1629"
        android:contentDescription="Back"
        android:onClick="finish"
        android:padding="10dp"
        android:src="@drawable/ic_arrow"
        app:tint="#00D4FF" />

</FrameLayout>
